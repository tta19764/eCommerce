{
  "Gateway": {
    "HeaderName": "X-Gateway-Signature",
    "Signature": "local-dev-gateway-signature"
  },
  "Swagger": {
    "Services": [
      {
        "Name": "authentication",
        "DisplayName": "Authentication API",
        "Address": "https://localhost:7168",
        "RoutePrefix": "/auth-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "products",
        "DisplayName": "Product API",
        "Address": "https://localhost:7276",
        "RoutePrefix": "/product-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "orders",
        "DisplayName": "Order API",
        "Address": "https://localhost:7228",
        "RoutePrefix": "/order-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "payments",
        "DisplayName": "Payment API",
        "Address": "https://localhost:7268",
        "RoutePrefix": "/payment-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "users",
        "DisplayName": "User API",
        "Address": "https://localhost:7238",
        "RoutePrefix": "/user-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "images",
        "DisplayName": "Image API",
        "Address": "https://localhost:7008",
        "RoutePrefix": "/image-api",
        "DocumentPath": "/openapi/v1.json"
      },
      {
        "Name": "messaging",
        "DisplayName": "Messaging API",
        "Address": "https://localhost:7258",
        "RoutePrefix": "/messaging-api",
        "DocumentPath": "/openapi/v1.json"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/product-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/user-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "image-route": {
        "ClusterId": "image-cluster",
        "Match": {
          "Path": "/image-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "messaging-route": {
        "ClusterId": "messaging-cluster",
        "Match": {
          "Path": "/messaging-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7168"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7276"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7228"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7268"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7238"
          }
        }
      },
      "image-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7008"
          }
        }
      },
      "messaging-cluster": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:7258"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
