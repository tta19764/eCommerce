{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=authentication_db;Username=postgres;Password=postgres",
    "rabbitmq": "amqp://guest:guest@localhost:5672"
  },
  "Authentication": {
    "Audience": "ecommerce-auth",
    "MetadataUrl": "http://localhost:8080/realms/ecommerce/.well-known/openid-configuration",
    "RequireHttpsMetadata": false,
    "Issuer": "http://localhost:8080/realms/ecommerce"
  },
  "Keycloak": {
    "AdminUrl": "http://localhost:8080/admin/realms/ecommerce/",
    "TokenUrl": "http://localhost:8080/realms/ecommerce/protocol/openid-connect/token",
    "AdminClientId": "ecommerce-admin",
    "AdminClientSecret": "sIMggyVP4hhGwlORdU8GA5Vgl7tNnpBd",
    "AuthClientId": "ecommerce-auth",
    "AuthClientSecret": "Vn3n7qxK9EPzofF3kRrPlMua1hzmhsFV"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({ThreadId}) {MachineName} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
